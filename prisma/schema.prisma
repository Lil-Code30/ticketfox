// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum UserRole {
  ADMIN
  TECHNICIAN
  MANAGER
  USER
}

enum KnowledgeType {
  INCIDENT
  DOCUMENTATION
  RESOURCE
  NOTE
  CHECKLIST
  SCRIPT
}

enum KnowledgeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BlockType {
  HEADING
  PARAGRAPH
  STEP
  BULLET_LIST
  NUMBERED_LIST
  IMAGE
  CODE
  WARNING
  CHECKLIST
  QUOTE
  FILE_REFERENCE
}

enum FileType {
  IMAGE
  PDF
  DOCX
  TXT
  ZIP
  OTHER
}

//////////////////////////////////////////////////////
// USERS
//////////////////////////////////////////////////////

model User {
  id String @id @default(cuid())

  clerkId String @unique

  email     String?
  firstName String?
  lastName  String?

  role UserRole @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  knowledge Knowledge[]
  files     File[]

  @@index([clerkId])
}

//////////////////////////////////////////////////////
// KNOWLEDGE
//////////////////////////////////////////////////////

model Knowledge {
  id String @id @default(cuid())

  title String
  slug  String @unique

  summary String? @db.Text

  type KnowledgeType

  status KnowledgeStatus @default(PUBLISHED)

  source String?

  categoryId String?

  authorId String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  category Category? @relation(fields: [categoryId], references: [id])

  author User? @relation(fields: [authorId], references: [id])

  blocks Block[]

  tags KnowledgeTag[]

  attachments KnowledgeAttachment[]

  embedding KnowledgeEmbedding?

  @@index([type])
  @@index([status])
  @@index([categoryId])
  @@index([authorId])
  @@index([title])
}

//////////////////////////////////////////////////////
// BLOCKS
//////////////////////////////////////////////////////

model Block {
  id String @id @default(cuid())

  knowledgeId String

  type BlockType

  order Int

  content String? @db.Text

  metadata Json?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  knowledge Knowledge @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)

  attachments BlockAttachment[]

  @@index([knowledgeId])
  @@index([order])
}

//////////////////////////////////////////////////////
// CATEGORIES
//////////////////////////////////////////////////////

model Category {
  id String @id @default(cuid())

  name String @unique

  description String?

  color String?

  icon String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  knowledge Knowledge[]
}

//////////////////////////////////////////////////////
// TAGS
//////////////////////////////////////////////////////

model Tag {
  id String @id @default(cuid())

  name String @unique

  color String?

  createdAt DateTime @default(now())

  knowledge KnowledgeTag[]
}

//////////////////////////////////////////////////////
// MANY TO MANY
//////////////////////////////////////////////////////

model KnowledgeTag {
  knowledgeId String
  tagId       String

  knowledge Knowledge @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([knowledgeId, tagId])
}

//////////////////////////////////////////////////////
// FILES
//////////////////////////////////////////////////////

model File {
  id String @id @default(cuid())

  name String

  originalName String

  mimeType String

  type FileType

  size Int

  storageKey String

  url String

  uploadedById String?

  createdAt DateTime @default(now())

  uploadedBy User? @relation(fields: [uploadedById], references: [id])

  knowledgeRefs KnowledgeAttachment[]

  blockRefs BlockAttachment[]

  @@index([uploadedById])
}

//////////////////////////////////////////////////////
// KNOWLEDGE FILES
//////////////////////////////////////////////////////

model KnowledgeAttachment {
  id String @id @default(cuid())

  knowledgeId String

  fileId String

  knowledge Knowledge @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([knowledgeId, fileId])
}

//////////////////////////////////////////////////////
// BLOCK FILES
//////////////////////////////////////////////////////

model BlockAttachment {
  id String @id @default(cuid())

  blockId String

  fileId String

  block Block @relation(fields: [blockId], references: [id], onDelete: Cascade)

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockId, fileId])
}

//////////////////////////////////////////////////////
// AI READY
//////////////////////////////////////////////////////

model KnowledgeEmbedding {
  id String @id @default(cuid())

  knowledgeId String @unique

  embeddingId String?

  model String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  knowledge Knowledge @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
}

//////////////////////////////////////////////////////
// MCP READY
//////////////////////////////////////////////////////

model ExternalResource {
  id String @id @default(cuid())

  title String

  source String

  url String

  description String?

  createdAt DateTime @default(now())
}

//////////////////////////////////////////////////////
// AGENT MEMORY (PHASE 5)
//////////////////////////////////////////////////////

model AgentConversation {
  id String @id @default(cuid())

  title String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  messages AgentMessage[]
}

model AgentMessage {
  id String @id @default(cuid())

  conversationId String

  role String

  content String @db.Text

  createdAt DateTime @default(now())

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}
